# 本地数据（设备档案、SQLite、解密临时文件），绝不入库
/data/
*.db
*.db-wal
*.db-shm
*.db.bak-*
/tmp/

# 构建产物
/bin/
/dist/
*.exe
# Windows 资源（图标/manifest/版本信息）由 wails3 generate syso 生成到 cmd/app/，
# 带架构后缀、构建脚本每次覆盖；gitignore 但不删除，让裸 go build 也能带上图标。
*.syso
# 注意：build/ 不再整体忽略——build/appicon.png 与 build/windows/{icon.ico,
# wails.exe.manifest,info.json} 是入库的源资产（由 scripts/make-icon.ps1 生成 ICO）。

# Wails v3 生成物（T10 起）
# frontend/bindings/ 由 `wails3 generate bindings -ts -d frontend/bindings ./cmd/app` 生成，
# 生成物入库（首辅裁断：CI 先 npm run build 再 wails3 build，不入库首跑必红）。
frontend/dist/
frontend/node_modules/

# 工具与系统
node_modules/
*.log
.DS_Store
Thumbs.db
hg-detail-*.png
